generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(uuid())
  name             String?
  email            String          @unique
  password         String
  role             Role            @default(USER)
  createdAt        DateTime        @default(now())
  isPro            Boolean         @default(false)
  avatar           String?
  bio              String?
  plan             Plan            @default(FREE)
  stripeCustomerId String?
  isBanned         Boolean         @default(false)
  planSource       String?         @default("UNKNOWN")
  notifications    Notification[]
  payouts          PayoutRequest[]
  createdWorks     Project[]       @relation("AuthorProjects")
  purchases        Purchase[]
  reviews          Review[]
  savedProjects    SavedProject[]
  tickets          Ticket[]
  cart             Cart?
}

model Project {
  id              String         @id @default(uuid())
  title           String
  videoUrl        String
  categories      String
  tags            String?
  status          String         @default("Active")
  createdAt       DateTime       @default(now())
  price           Float          @default(0)
  downloads       Int            @default(0)
  authorId        String?
  isPremium       Boolean        @default(false)
  productType     ProductType    @default(COMPONENT)
  sourceCode      String?
  description     String?
  rating          Float          @default(5.0)
  reviewCount     Int            @default(0)
  sourceCodeHtml  String?
  sourceCodeReact String?
  sourceCodeVue   String?
  sourceUrl       String?
  techStack       String?
  demoUrl         String?
  dependencies    String?
  fileUrl         String?

  author          User?          @relation("AuthorProjects", fields: [authorId], references: [id])
  purchasedBy     Purchase[]
  reviews         Review[]
  savedBy         SavedProject[]
  cartItems       CartItem[]

  @@index([status])
  @@index([isPremium])
  @@index([categories])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  userId    String
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id          String   @id @default(uuid())
  cartId      String
  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  licenseType String   @default("STANDARD")
  price       Float    @default(0)
  createdAt   DateTime @default(now())

  @@unique([cartId, projectId])
  @@index([cartId])
  @@index([projectId])
}


model Purchase {
  id          String   @id @default(uuid())
  userId      String
  projectId   String
  createdAt   DateTime @default(now())
  pricePaid   Float?   @default(0)
  licenseType String   @default("STANDARD")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model SavedProject {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model Ticket {
  id        String   @id @default(uuid())
  subject   String
  message   String
  status    String   @default("OPEN")
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model PayoutRequest {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
}

enum ProductType {
  COMPONENT
  ANIMATION
  TEMPLATE
  EFFECT
}
